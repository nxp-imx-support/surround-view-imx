<?xml version="1.0"?>
<auomatic_calibration>
	<path>
		<camera_inputs>Content/CameraInputs</camera_inputs>
		<camera_models>Content/Generated/CameraModels</camera_models>
		<template>Content/Templates</template>
	</path>
	<camera>
		<number>4</number>
		<dewarp>@PARAM_CAM_DEWARP@</dewarp>
		<camera1>
			<height>@PARAM_CAM_HEIGHT@</height>
			<width>@PARAM_CAM_WIDTH@</width>
			<sf>7</sf>
			<roi>80</roi>
			<contour_min_size>200</contour_min_size>
			<chessboard_num>3</chessboard_num>
			<source>@PARAM_CAM_1_SRC@</source>
			<format>@PARAM_CAM_FORMAT@</format>
		</camera1>
		<camera2>
			<height>@PARAM_CAM_HEIGHT@</height>
			<width>@PARAM_CAM_WIDTH@</width>
			<sf>7</sf>
			<roi>80</roi>
			<contour_min_size>200</contour_min_size>
			<chessboard_num>3</chessboard_num>
			<source>@PARAM_CAM_2_SRC@</source>
			<format>@PARAM_CAM_FORMAT@</format>
		</camera2>
		<camera3>
			<height>@PARAM_CAM_HEIGHT@</height>
			<width>@PARAM_CAM_WIDTH@</width>
			<sf>7</sf>
			<roi>80</roi>
			<contour_min_size>200</contour_min_size>
			<chessboard_num>3</chessboard_num>
			<source>@PARAM_CAM_3_SRC@</source>
			<format>@PARAM_CAM_FORMAT@</format>
		</camera3>
		<camera4>
			<height>@PARAM_CAM_HEIGHT@</height>
			<width>@PARAM_CAM_WIDTH@</width>
			<sf>7</sf>
			<roi>80</roi>
			<contour_min_size>200</contour_min_size>
			<chessboard_num>3</chessboard_num>
			<source>@PARAM_CAM_4_SRC@</source>
			<format>@PARAM_CAM_FORMAT@</format>
		</camera4>
	</camera>
	<display>
		<height>1080</height>
		<width>1920</width>
		<show_debug_img>0</show_debug_img>
		<max_fps>60</max_fps>
		<fullscreen>1</fullscreen>
	</display>
	<grid>
		<angles>60</angles>
		<start_angle>4</start_angle>
		<nop_z>30</nop_z>
		<step_x>0.2</step_x>
		<radius>1.7</radius>
	</grid>
	<mask>
		<smooth_angle>0.2</smooth_angle>
	</mask>
	<car_model>
		<x_scale>1.6</x_scale>
		<y_scale>1.6</y_scale>
		<z_scale>1.6</z_scale>
	</car_model>
	<obj_det>
		<enable_detection>@PARAM_DECTECTION@</enable_detection>
		<max_ips>48</max_ips>
	</obj_det>
	<exposure_correction>
		<ec_refresh_rate>600</ec_refresh_rate>
	</exposure_correction>
</auomatic_calibration>